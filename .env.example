APP_NAME="DistroSKU DBA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/New_York
APP_URL=https://dba.distrosku.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- DistroSKU DBA ---
DBA_OWNER_EMAIL=
DBA_OWNER_NAME=
# Only read by `php artisan dba:make-owner`; remove it from .env after the owner exists (or leave blank to be prompted).
DBA_OWNER_PASSWORD=
# Extra alert recipients (comma-separated); all admins always get alerts.
DBA_ALERT_EMAILS=
DBA_DOWN_AFTER=2
DBA_HTTP_TIMEOUT=20
# Releases page: owner/repo for GitHub tags (token optional, read-only "contents" scope), or a fixed latest version.
DBA_GITHUB_REPO=
DBA_GITHUB_TOKEN=
DBA_LATEST_VERSION=
